# Local PostgreSQL (Docker):
DATABASE_URL="postgresql://careeros:careeros@localhost:5432/careeros?schema=public"
DIRECT_URL="postgresql://careeros:careeros@localhost:5432/careeros?schema=public"
# Hosted / Production (Supabase PostgreSQL):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=public"
PORT=3001
NODE_ENV="development"
# Rate limiting / Throttler (Docker Redis or cloud Redis instance)
REDIS_URL="redis://localhost:6380"

BETTER_AUTH_SECRET="dev-secret-minimum-32-characters-long-for-local-use-only"
BETTER_AUTH_URL="http://localhost:3001"

BYOK_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CORS_ORIGIN="http://localhost:3000"
RESEND_API_KEY=""
CONTACT_EMAIL=""
FEEDBACK_EMAIL=""
APIFY_API_TOKEN=""
