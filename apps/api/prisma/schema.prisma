generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ResumeOutputFormat {
  HTML
  LATEX
  PDF
}

/// Owned by Better Auth (core). Fields/relations below match what the
/// Prisma adapter + organization plugin expect — see auth/better-auth.instance.ts
/// for the `modelName`/`fields` remap that points Better Auth at this table.
model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  name          String?
  avatar        String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  memberships   Member[]
  invitations   Invitation[] @relation("InviterUser")
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

/// Better Auth core table. Stores active sessions (replaces the old
/// custom access/refresh JWT pair with a single opaque session token).
model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  token                String   @unique
  expiresAt            DateTime @map("expires_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Better Auth core table. One row per login method per user —
/// email/password hash lives here now (providerId = "credential"),
/// not on User. This is where OAuth providers would also attach.
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

/// Better Auth core table. Email-verification tokens, password-reset
/// tokens, etc.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

/// Better Auth canonical organization model.
model Organization {
  id             String               @id @default(uuid()) @db.Uuid
  name           String
  slug           String               @unique
  logo           String?
  createdAt      DateTime             @default(now()) @map("created_at")
  metadata       String?
  members        Member[]
  invitations    Invitation[]
  byokKeys       ByokCredential[]
  careerProfile  MasterCareerProfile?
  resumeProfiles ResumeProfile[]
  jobStates      WorkspaceJobState[]
  jobMatches     JobMatch[]

  @@map("organizations")
}

/// Better Auth canonical organization member model.
model Member {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("members")
}

/// Better Auth canonical organization invitation model.
model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  inviterId      String       @map("inviter_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("InviterUser", fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model ByokCredential {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  provider       String
  encryptedKey   String       @map("encrypted_key")
  iv             String
  authTag        String       @map("auth_tag")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("byok_credentials")
}
model MasterCareerProfile {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @unique @map("organization_id") @db.Uuid
  fullName       String               @map("full_name")
  headline       String?
  location       String?
  email          String?
  version        Int                  @default(1)
  status         String               @default("active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  education      EducationEntry[]
  experiences    ExperienceEntry[]
  projects       ProjectEntry[]
  achievements   AchievementEntry[]
  skills         SkillEntry[]
  technologies   TechnologyEntry[]
  publications   PublicationEntry[]
  hackathons     HackathonEntry[]
  certifications CertificationEntry[]
  links          CareerLink[]

  @@map("master_career_profiles")
}

model EducationEntry {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  institution     String
  degree          String?
  fieldOfStudy    String?             @map("field_of_study")
  startDate       String?             @map("start_date")
  endDate         String?             @map("end_date")
  highlights      String[]            @default([])
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("education_entries")
}

model ExperienceEntry {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  company         String
  title           String
  location        String?
  startDate       String?             @map("start_date")
  endDate         String?             @map("end_date")
  current         Boolean             @default(false)
  bullets         String[]            @default([])
  technologies    String[]            @default([])
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experience_entries")
}

model ProjectEntry {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  name            String
  description     String?
  url             String?
  repositoryUrl   String?             @map("repository_url")
  bullets         String[]            @default([])
  technologies    String[]            @default([])
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("project_entries")
}

model AchievementEntry {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  title           String
  description     String?
  date            String?
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("achievement_entries")
}

model SkillEntry {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  name            String
  category        String?
  proficiency     String?
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("skill_entries")
}

model TechnologyEntry {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  name            String
  category        String?
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("technology_entries")
}

model PublicationEntry {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  title           String
  publisher       String?
  date            String?
  url             String?
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("publication_entries")
}

model HackathonEntry {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  name            String
  organizer       String?
  date            String?
  achievement     String?
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("hackathon_entries")
}

model CertificationEntry {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  name            String
  issuer          String?
  issueDate       String?             @map("issue_date")
  expirationDate  String?             @map("expiration_date")
  credentialUrl   String?             @map("credential_url")
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("certification_entries")
}

model CareerLink {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  label           String
  url             String
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("career_links")
}

model ResumeProfile {
  id                       String          @id @default(uuid()) @db.Uuid
  organizationId           String          @map("organization_id") @db.Uuid
  name                     String
  roleFocus                String?         @map("role_focus")
  visibleSections          String[]        @default([]) @map("visible_sections")
  sectionOrder             String[]        @default([]) @map("section_order")
  summaryGuidance          String?         @map("summary_guidance")
  highlightRules           Json            @default("[]") @map("highlight_rules")
  priorityProjectIds       String[]        @default([]) @map("priority_project_ids") @db.Uuid
  prioritySkillIds         String[]        @default([]) @map("priority_skill_ids") @db.Uuid
  priorityExperienceIds    String[]        @default([]) @map("priority_experience_ids") @db.Uuid
  priorityAchievementIds   String[]        @default([]) @map("priority_achievement_ids") @db.Uuid
  priorityCertificationIds String[]        @default([]) @map("priority_certification_ids") @db.Uuid
  templateId               String?         @map("template_id")
  styleSettings            Json            @default("{}") @map("style_settings")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")
  organization             Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions                 ResumeVersion[]
  matches                  JobMatch[]

  @@index([organizationId])
  @@map("resume_profiles")
}

model ResumeVersion {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  resumeProfileId     String             @map("resume_profile_id") @db.Uuid
  targetCompany       String?            @map("target_company")
  targetRole          String?            @map("target_role")
  masterProfileSnapshot Json             @map("master_profile_snapshot")
  selectedRecordIds   Json               @map("selected_record_ids")
  templateVersion     String?            @map("template_version")
  outputFormat        ResumeOutputFormat @default(HTML) @map("output_format")
  jobAnalysisEvidence Json?              @map("job_analysis_evidence")
  matchResult         Json?              @map("match_result")
  confidence          Float?
  explanation         String?
  artifactMetadata    Json?              @map("artifact_metadata")
  createdAt           DateTime           @default(now()) @map("created_at")
  resumeProfile       ResumeProfile      @relation(fields: [resumeProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([resumeProfileId])
  @@map("resume_versions")
}

model Job {
  id                 String               @id @default(uuid()) @db.Uuid
  externalId         String?              @map("external_id")
  fingerprint        String?
  source             String               @default("manual")
  sourceUrl          String?              @map("source_url")
  company            String
  title              String
  location           String
  isRemote           Boolean              @default(false) @map("is_remote")
  remotePolicy       String?              @map("remote_policy")
  employmentType     String?              @map("employment_type")
  salaryMin          Float?               @map("salary_min")
  salaryMax          Float?               @map("salary_max")
  salaryCurrency     String?              @map("salary_currency")
  salaryRange        String?              @map("salary_range")
  description        String?
  requiredSkills     String[]             @default([]) @map("required_skills")
  preferredSkills    String[]             @default([]) @map("preferred_skills")
  postedAt           DateTime?            @map("posted_at")
  expiresAt          DateTime?            @map("expires_at")
  rawMetadata        Json?                @map("raw_metadata")
  normalizedMetadata Json?                @map("normalized_metadata")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  workspaceStates    WorkspaceJobState[]
  matches            JobMatch[]

  @@unique([source, externalId])
  @@unique([fingerprint])
  @@index([company])
  @@index([title])
  @@map("jobs")
}

model WorkspaceJobState {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  jobId          String       @map("job_id") @db.Uuid
  status         String       @default("discovered")
  isSaved        Boolean      @default(false) @map("is_saved")
  isDismissed    Boolean      @default(false) @map("is_dismissed")
  notes          String?
  appliedAt      DateTime?    @map("applied_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([organizationId, jobId])
  @@index([organizationId])
  @@index([jobId])
  @@map("workspace_job_states")
}

model JobMatch {
  id              String         @id @default(uuid()) @db.Uuid
  jobId           String         @map("job_id") @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  resumeProfileId String?        @map("resume_profile_id") @db.Uuid
  overallScore    Float          @map("overall_score")
  skillScore      Float          @map("skill_score")
  roleScore       Float          @map("role_score")
  experienceScore Float          @map("experience_score")
  locationScore   Float          @map("location_score")
  seniorityScore  Float          @map("seniority_score")
  matchedSkills   String[]       @default([]) @map("matched_skills")
  missingSkills   String[]       @default([]) @map("missing_skills")
  confidence      Float          @default(1.0)
  explanation     String
  evidence        Json?
  profileVersion  Int?           @map("profile_version")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  job             Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resumeProfile   ResumeProfile? @relation(fields: [resumeProfileId], references: [id], onDelete: SetNull)

  @@unique([organizationId, jobId, resumeProfileId])
  @@index([organizationId])
  @@index([jobId])
  @@map("job_matches")
}