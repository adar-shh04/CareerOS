model CertificationEntry {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  name            String
  issuer          String?
  issueDate       String?             @map("issue_date")
  expirationDate  String?             @map("expiration_date")
  credentialUrl   String?             @map("credential_url")
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("certification_entries")
}

model CareerLink {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @map("profile_id") @db.Uuid
  label           String
  url             String
  source          String?
  sourceReference String?             @map("source_reference")
  profile         MasterCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("career_links")
}

model ResumeProfile {
  id                       String          @id @default(uuid()) @db.Uuid
  workspaceId              String          @map("workspace_id") @db.Uuid
  name                     String
  roleFocus                String?         @map("role_focus")
  visibleSections          String[]        @default([]) @map("visible_sections")
  sectionOrder             String[]        @default([]) @map("section_order")
  summaryGuidance          String?         @map("summary_guidance")
  highlightRules           Json            @default("[]") @map("highlight_rules")
  priorityProjectIds       String[]        @default([]) @map("priority_project_ids") @db.Uuid
  prioritySkillIds         String[]        @default([]) @map("priority_skill_ids") @db.Uuid
  priorityExperienceIds    String[]        @default([]) @map("priority_experience_ids") @db.Uuid
  priorityAchievementIds   String[]        @default([]) @map("priority_achievement_ids") @db.Uuid
  priorityCertificationIds String[]        @default([]) @map("priority_certification_ids") @db.Uuid
  templateId               String?         @map("template_id")
  styleSettings            Json            @default("{}") @map("style_settings")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")
  workspace                Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions                 ResumeVersion[]

  @@index([workspaceId])
  @@map("resume_profiles")
}

model ResumeVersion {
  id                  String             @id @default(uuid()) @db.Uuid
  workspaceId         String             @map("workspace_id") @db.Uuid
  resumeProfileId     String             @map("resume_profile_id") @db.Uuid
  targetCompany       String?            @map("target_company")
  targetRole          String?            @map("target_role")
  masterProfileSnapshot Json             @map("master_profile_snapshot")
  selectedRecordIds   Json               @map("selected_record_ids")
  templateVersion     String?            @map("template_version")
  outputFormat        ResumeOutputFormat @default(HTML) @map("output_format")
  jobAnalysisEvidence Json?              @map("job_analysis_evidence")
  matchResult         Json?              @map("match_result")
  confidence          Float?
  explanation         String?
  artifactMetadata    Json?              @map("artifact_metadata")
  createdAt           DateTime           @default(now()) @map("created_at")
  resumeProfile       ResumeProfile      @relation(fields: [resumeProfileId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([resumeProfileId])
  @@map("resume_versions")
}
