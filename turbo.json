{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["APIFY_API_TOKEN", "BETTER_AUTH_SECRET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["DATABASE_URL", "BYOK_ENCRYPTION_KEY", "BETTER_AUTH_SECRET"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "NODE_ENV",
        "CAREEROS_API_URL",
        "CORS_ORIGIN",
        "PORT",
        "BETTER_AUTH_SECRET",
        "RESEND_API_KEY",
        "CONTACT_EMAIL",
        "FEEDBACK_EMAIL"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "env": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
